# Crie um arquivo `.env` copiando este modelo e preenchendo com seus dados.
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)
#
# NUNCA envie o `.env` real para o git (ele esta no .gitignore).

# Host/porta do servidor MySQL.
DB_HOST=localhost
DB_PORT=3306

# Credenciais. Se rodar `setup_mysql.sql`, use o usuario criado nele.
DB_USER=sportsbet
DB_PASSWORD=sportsbet123

# Nome do banco de dados da aplicacao.
DB_NAME=brasiliaodb